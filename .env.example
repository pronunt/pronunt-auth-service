# Core runtime
APP_NAME=pronunt-auth-service
APP_ENV=<set-app-environment>
APP_HOST=<set-bind-host>
APP_PORT=<set-bind-port>
LOG_LEVEL=<set-log-level>
LOG_USE_COLORS=<true-or-false>
REQUEST_ID_HEADER=<set-request-id-header>
HTTP_TIMEOUT_SECONDS=<set-http-timeout-seconds>

# Data storage
MONGODB_URI=<set-mongodb-uri>
MONGODB_DATABASE=<set-mongodb-database>
MONGODB_CONNECTION_COLLECTION=<set-connection-collection-name>

# Auth and JWT validation
AUTH_ENABLED=<true-or-false>
ALLOW_UNSAFE_DEV_AUTH=<true-or-false>
KEYCLOAK_ISSUER=<set-keycloak-issuer>
KEYCLOAK_AUDIENCE=<set-keycloak-audience>
KEYCLOAK_JWKS_URL=<set-keycloak-jwks-url>
SESSION_JWT_SECRET=<set-session-jwt-secret>
SESSION_JWT_ISSUER=<set-session-jwt-issuer>
SESSION_TTL_SECONDS=<set-session-ttl-seconds>
INTERNAL_SERVICE_TOKEN=<set-shared-internal-service-token>

# GitHub OAuth
GITHUB_API_URL=<set-github-api-url>
GITHUB_OAUTH_AUTHORIZE_URL=<set-github-oauth-authorize-url>
GITHUB_OAUTH_ACCESS_TOKEN_URL=<set-github-oauth-access-token-url>
GITHUB_OAUTH_CLIENT_ID=<set-github-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<set-github-oauth-client-secret>
GITHUB_OAUTH_REDIRECT_URI=<set-public-auth-callback-uri>
GITHUB_OAUTH_SCOPES=<set-github-oauth-scopes>
FRONTEND_AUTH_SUCCESS_URL=<set-public-frontend-success-url>
FRONTEND_AUTH_FAILURE_URL=<set-public-frontend-failure-url>

# Optional GitHub App values for later installation-based flows
GITHUB_APP_ID=<set-github-app-id>
GITHUB_INSTALLATION_ID=<set-github-installation-id>
GITHUB_PRIVATE_KEY_PATH=<set-private-key-mount-path>
