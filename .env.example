APP_NAME=pronunt-auth-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_USE_COLORS=true
REQUEST_ID_HEADER=X-Request-ID
AUTH_ENABLED=false
ALLOW_UNSAFE_DEV_AUTH=true
KEYCLOAK_ISSUER=http://keycloak.pronunt.com/realms/pronunt
KEYCLOAK_AUDIENCE=pronunt-api
KEYCLOAK_JWKS_URL=http://keycloak.pronunt.com/realms/pronunt/protocol/openid-connect/certs
GITHUB_APP_ID=replace-me
GITHUB_INSTALLATION_ID=replace-me
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
